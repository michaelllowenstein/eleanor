{
  "name": "@eleanor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/core/migrate.ts",
