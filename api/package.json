    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.2",
    "cookie": "^0.7.2",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7"
  }
