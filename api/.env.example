# Copy to api/.env for local development:  cp api/.env.example api/.env
# Production values are set in the hosting platform, never in a file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://eleanor:eleanor@localhost:5432/eleanor
REDIS_URL=redis://localhost:6379

# The origin the browser sees. In dev that is the Angular dev server, which
# proxies /api to this process. In prod it is the Vercel domain.
PUBLIC_ORIGIN=http://localhost:4200

# Local mock IdP from docker-compose.yml (any client id/secret is accepted).
OIDC_ISSUER=http://localhost:8080/eleanor
OIDC_CLIENT_ID=eleanor-local
OIDC_CLIENT_SECRET=eleanor-local-secret

# Must be the registrable domain of PUBLIC_ORIGIN (no scheme, no port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Eleanor

# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_VALUE

REALTIME_MODEL=gpt-realtime-2.1
SESSION_TTL_SECONDS=28800
STEP_UP_TTL_SECONDS=300
PASSKEY_ENROLLMENT_MAX_OIDC_AGE_SECONDS=600
REALTIME_SESSION_RATE_LIMIT_PER_MINUTE=20
