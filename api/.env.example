# Copy to api/.env for local development:  cp api/.env.example api/.env
# Production values are set in Railway's service variables, never in a file.

NODE_ENV=development
PORT=3000

# ── Logging & tracing (docs/OBSERVABILITY.md) ──────────────────────────────
# Default level for every category.
LOG_LEVEL=info
# Per-category overrides: realtime, provider, http, auth, audit, ratelimit,
# health, boot, client (browser logs; also client.realtime, client.realtime.webrtc).
LOG_TRACE=realtime=debug,provider=debug,client=debug
# pretty for a terminal, json for Railway (default: pretty in dev, json in prod).
LOG_FORMAT=pretty
# Accept batched browser logs on POST /api/telemetry/client.
CLIENT_LOG_INGEST=true
TELEMETRY_RATE_LIMIT_PER_MINUTE=120

# ── Audit trail ────────────────────────────────────────────────────────────
AUDIT_TRAIL_ENABLED=true
AUDIT_RETENTION_DAYS=30

# ── Infrastructure ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://eleanor:eleanor@localhost:5432/eleanor
REDIS_URL=redis://localhost:6379

# The origin the browser sees. In dev that is the Angular dev server, which
# proxies /api to this process. In prod it is the Vercel domain.
PUBLIC_ORIGIN=https://localhost:4141

# Production only: the value Vercel adds as x-origin-secret (openssl rand -hex 32).
# Comma-separate two values while rotating. Leave empty locally.
ORIGIN_SECRET=
TRUST_PROXY_HOPS=1

# ── Identity ───────────────────────────────────────────────────────────────
# Local mock IdP from api/docker-compose.yml (any client id/secret is accepted).
OIDC_ISSUER=http://localhost:8080/eleanor
OIDC_CLIENT_ID=eleanor-local
OIDC_CLIENT_SECRET=eleanor-local-secret
# prompt for forced re-login; "login" for most IdPs, empty for Google.
OIDC_REAUTH_PROMPT=login
# Comma-separated verified emails allowed to sign in. Empty = anyone.
ALLOWED_EMAILS=

# Must equal or be a parent of the PUBLIC_ORIGIN host (no scheme, no port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Eleanor

# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_VALUE

# ── Realtime ───────────────────────────────────────────────────────────────
# openai | mock (mock pairs with realtimeTransport: "mock" in client env.ts)
REALTIME_PROVIDER=openai
REALTIME_MODEL=gpt-realtime-2.1
SESSION_TTL_SECONDS=28800
STEP_UP_TTL_SECONDS=300
PASSKEY_ENROLLMENT_MAX_OIDC_AGE_SECONDS=600
REALTIME_SESSION_RATE_LIMIT_PER_MINUTE=20
