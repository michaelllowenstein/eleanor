{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci && npm run build -w @eleanor/api",
    "watchPatterns": [
      "/apps/api/**",
      "/package.json",
      "/package-lock.json"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "npm run migrate:prod -w @eleanor/api"
    ],
    "startCommand": "npm run start -w @eleanor/api",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": "30",
    "drainingSeconds": "15"
  }
}
